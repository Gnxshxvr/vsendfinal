# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Optional - defaults to in-memory ephemeral storage if not provided)
# For Supabase / PostgreSQL, provide standard Postgres URI:
# DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Media Storage (Optional - defaults to local uploads/ directory if not provided)
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Or individually:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Supabase Integration (Optional - only required if using external Supabase directly)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend Environment Variables (for decoupled deployment like Vercel frontend + Railway backend)
# VITE_API_URL=https://your-backend.railway.app
# VITE_WS_URL=wss://your-backend.railway.app/ws
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key
