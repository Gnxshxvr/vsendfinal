# Server Configuration
PORT=5000
NODE_ENV=development

# Database (Optional - defaults to in-memory ephemeral storage if not provided)
# For Supabase / PostgreSQL, provide standard Postgres URI:
# DATABASE_URL=postgresql://postgres:your_password@db.your_project.supabase.co:5432/postgres

# Media Storage (Optional - defaults to local uploads/ directory if not provided)
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
# Or individually:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Supabase Integration (Optional - only required if using external Supabase directly)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Frontend Environment Variables (for decoupled deployment like Vercel frontend + Railway backend)
# VITE_API_URL=https://your-backend.railway.app
# VITE_WS_URL=wss://your-backend.railway.app/ws
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_key

# ==============================================================================
# WebRTC Cross-Network & NAT Traversal Configuration
# ==============================================================================
# By default, VSend uses public Google and Cloudflare STUN servers for direct P2P.
# STUN successfully traverses Full-Cone, Restricted Cone, and Port-Restricted NATs.
#
# When clients are behind Strict/Symmetric NATs (e.g., mobile 4G/5G carriers,
# enterprise VPNs, or restrictive university firewalls), direct UDP hole punching
# fails. A TURN (Traversal Using Relays around NAT) server is required as fallback.
#
# Option A: TURN server credentials (e.g., OpenRelay, Metered.ca, Twilio, Coturn)
# TURN_SERVER_URL=turn:openrelay.metered.ca:80
# TURN_USERNAME=openrelayproject
# TURN_CREDENTIAL=openrelayproject
#
# Option B: Full JSON array of RTCIceServer specifications
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:your-turn-server.com:3478","username":"user","credential":"password"}]
